# Copy to .env and fill in what you need. Never commit .env.
# `worldmodel-data keys` shows which of these are set.

# Where the pipeline keeps raw files, vintages and warehouse builds (default ./var)
# WORLDMODEL_HOME=./var

# Which warehouse the app reads: a .duckdb file, or a data folder with warehouse/CURRENT.
# Default: ./var if it has a live build, else the sample in app/sample/.
# WORLDMODEL_WAREHOUSE=./var

# Keys (see contract/worldmodel_contract/catalogues/api_keys.yaml; Data status lists them too)
# STATSNZ_API_KEY=
# GIE_API_KEY=
# COMTRADE_API_KEY=
# ACLED_API_KEY=
# ACLED_EMAIL=
# EIA_API_KEY=
# IUCN_API_KEY=
# EPPO_API_KEY=
# Live ships on the map (free, sign in with GitHub at aisstream.io)
# AISSTREAM_API_KEY=
# Optional: more requests a day for live planes (OpenSky API client)
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# Crowd forecasts: your free Metaculus API token (account settings); a bot account's token is optional
# METACULUS_TOKEN=
# METACULUS_BOT_TOKEN=
# EMBER_API_KEY=
# FRED_API_KEY=

# Local AI: Ollama's address and the default model are set in the app (Settings: Local AI).
# Web search for the AI with Brave Search (paid past its $5 monthly credit; limits in Settings).
# BRAVE_API_KEY=
# Optional cloud model
# ANTHROPIC_API_KEY=
